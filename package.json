{
  "name": "lauher-games-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Lauher Games Hangman with local and persistent online multiplayer.",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev --host 0.0.0.0 --port 8080",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "build": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js build && npm run db:migrate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "preview": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/forca/rules.test.ts src/lib/forca/game-app.test.ts scripts/migration-plan.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
